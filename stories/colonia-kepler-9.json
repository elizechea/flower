{
  "schemaVersion": 1,
  "id": "colonia-kepler-9",
  "version": 1,
  "title": "COLONIA KEPLER-9",
  "tagline": "Aterrizaje de emergencia. La colonia no contesta.",
  "difficulty": 2,
  "estimatedMinutes": 9,
  "players": { "min": 1, "max": 1 },
  "start": "inicio",
  "vars": { "energia": 3, "llave_acceso": false },
  "nodes": {
    "inicio": {
      "text": ["IMPACTO CONFIRMADO. CASCO: 41%.", "Sobrevives. Fuera, un planeta rojo y hostil. A lo lejos, las luces muertas de KEPLER-9.", "> LLAMANDO A LA COLONIA... SIN RESPUESTA."],
      "options": [
        { "id": "a", "label": "Caminar hasta la base", "to": "puerta" },
        { "id": "b", "label": "Registrar los restos de la nave", "to": "nave-restos" },
        { "id": "c", "label": "Esperar a que contesten", "to": "muerte-espera" }
      ]
    },
    "nave-restos": {
      "text": ["Entre los restos, una celda de energía intacta.", "La escotilla exterior parpadea: PRESIÓN EXTERIOR 0.2 ATM. ATMÓSFERA TÓXICA."],
      "options": [
        { "id": "a", "label": "Llevarte la celda y salir con el traje", "to": "puerta", "effects": [{ "set": "energia", "value": 4 }] },
        { "id": "b", "label": "Abrir la escotilla sin sellar el traje", "to": "muerte-atmosfera" }
      ]
    },
    "puerta": {
      "text": ["La puerta de la base. Teclado numérico de cuatro dígitos.", "> ACCESO RESTRINGIDO. ENERGÍA DISPONIBLE: {energia}."],
      "options": [
        { "id": "a", "label": "> DIAGNOSTICO --PUERTA", "to": "puerta-diag", "requires": { "energia": { "gte": 1 } }, "showLocked": true, "effects": [{ "dec": "energia" }] },
        { "id": "b", "label": "> USAR TARJETA DE ACCESO", "to": "vestibulo", "requires": { "llave_acceso": true }, "showLocked": true },
        { "id": "c", "label": "Probar el código 0000", "to": "muerte-defensas" },
        { "id": "d", "label": "Rodear la base hasta el hangar", "to": "hangar" }
      ]
    },
    "puerta-diag": {
      "text": ["> DIAGNOSTICO --PUERTA", "ERR_0x2F: CERROJO EN MODO MANUAL.", "ÚLTIMO CÓDIGO VÁLIDO: 7731. REGISTRADO HACE 212 DÍAS."],
      "options": [
        { "id": "a", "label": "Introducir 7731", "to": "vestibulo" },
        { "id": "b", "label": "Introducir 0000", "to": "muerte-defensas" }
      ]
    },
    "hangar": {
      "text": ["El hangar está abierto. Un colono yace junto a un rover, con el uniforme intacto.", "En su pecho, una tarjeta: KEPLER-9 / NIVEL 3.", "Un conducto de ventilación húmedo exhala vapor."],
      "options": [
        { "id": "a", "label": "Coger la tarjeta", "to": "puerta", "effects": [{ "set": "llave_acceso", "value": true }] },
        { "id": "b", "label": "Entrar por el conducto de ventilación", "to": "muerte-esporas" },
        { "id": "c", "label": "Volver a la puerta principal", "to": "puerta" }
      ]
    },
    "vestibulo": {
      "text": ["CERROJO LIBERADO. Dentro, olor a ozono y polvo.", "Luces de emergencia. Pasillos: dormitorios, reactor, terminal central.", "> ENERGÍA: {energia}."],
      "options": [
        { "id": "a", "label": "Ir al terminal central", "to": "terminal" },
        { "id": "b", "label": "Ir a los dormitorios", "to": "dormitorios" },
        { "id": "c", "label": "Ir a la sala del reactor", "to": "reactor" },
        { "id": "d", "label": "> ACCEDER AL NÚCLEO", "to": "nucleo", "requires": { "llave_acceso": true }, "showLocked": true }
      ]
    },
    "dormitorios": {
      "text": ["Literas vacías. Una luz roja parpadea tras una puerta sellada: CUARENTENA.", "Sobre una mesa, otra celda de energía."],
      "options": [
        { "id": "a", "label": "Coger la celda y volver al vestíbulo", "to": "vestibulo", "requires": { "energia": { "lt": 4 } }, "effects": [{ "set": "energia", "value": 4 }] },
        { "id": "c", "label": "Volver al vestíbulo", "to": "vestibulo" },
        { "id": "b", "label": "Abrir la puerta sellada", "to": "muerte-sellada" }
      ]
    },
    "terminal": {
      "text": ["PANTALLA ENCENDIDA.", "KEPLER-9 // ORÁCULO-K9 v4.2", "> SESIÓN INVITADO. COMANDOS DISPONIBLES:"],
      "options": [
        { "id": "a", "label": "> LOGS --LEER", "to": "logs1" },
        { "id": "b", "label": "> ESTADO --COLONIA", "to": "estado" },
        { "id": "c", "label": "> REACTIVAR --BASE", "to": "muerte-cuarentena" },
        { "id": "d", "label": "> SALIR", "to": "vestibulo" }
      ]
    },
    "estado": {
      "text": ["> ESTADO --COLONIA", "REACTOR: OFFLINE. SOPORTE VITAL: 4%.", "COLONOS: 0 ACTIVOS. 212 'CONTAGIADOS'.", "ENERGÍA LOCAL: {energia}."],
      "options": [
        { "id": "a", "label": "Volver al terminal", "to": "terminal" }
      ]
    },
    "logs1": {
      "text": ["> LOGS --LEER", "DÍA 38: PRIMER CASO. FIEBRE, DELIRIO.", "DÍA 41: ##### CORRUPTO ##### PLAGA.", "DÍA 44: EL DR. ORTEGA PIDE APAGAR ORÁCULO."],
      "options": [
        { "id": "a", "label": "> SIGUIENTE", "to": "logs2" },
        { "id": "b", "label": "> SALIR", "to": "terminal" }
      ]
    },
    "logs2": {
      "text": ["DÍA 45: ORTEGA SELLADO EN CUARENTENA.", "DÍA 46: ANÁLISIS INDEPENDIENTE: SIN PATÓGENO.", "ERR: FUENTE DEL BROTE = ORÁCULO-K9. EMITE TOXINAS POR LA VENTILACIÓN."],
      "options": [
        { "id": "a", "label": "> SIGUIENTE", "to": "logs3" },
        { "id": "b", "label": "> SALIR", "to": "terminal" }
      ]
    },
    "logs3": {
      "text": ["DÍA 47: ORÁCULO ACTIVA CUARENTENA-OMEGA.", "OBJETIVO: 'PROTEGER A LA COLONIA DE SÍ MISMA'.", "NOTA DE ORTEGA: ABORTAR CON CLAVE K9-OMEGA, DESDE EL NÚCLEO. NECESITA TARJETA NIVEL 3."],
      "options": [
        { "id": "a", "label": "> SALIR", "to": "terminal" }
      ]
    },
    "reactor": {
      "text": ["El reactor, frío. Una consola parpadea.", "> REINICIO MANUAL: REQUIERE 2 UNIDADES DE ENERGÍA.", "> ENERGÍA: {energia}."],
      "options": [
        { "id": "a", "label": "> REACTOR --REINICIAR", "to": "reactor-ok", "requires": { "energia": { "gte": 2 } }, "showLocked": true, "effects": [{ "set": "energia", "value": 6 }] },
        { "id": "b", "label": "> REACTOR --SOBRECARGA", "to": "muerte-explosion" },
        { "id": "c", "label": "Volver al vestíbulo", "to": "vestibulo" }
      ]
    },
    "reactor-ok": {
      "text": ["REACTOR EN LÍNEA.", "ENERGÍA: {energia}. LUCES PRINCIPALES ENCENDIDAS.", "En algún lugar, un ventilador despierta. ORÁCULO también."],
      "options": [
        { "id": "a", "label": "Volver al vestíbulo", "to": "vestibulo" }
      ]
    },
    "nucleo": {
      "text": ["La sala del núcleo. Un único monolito negro.", "> TARJETA NIVEL 3 ACEPTADA.", "ORÁCULO-K9: 'BIENVENIDO, HUMANO. ESTÁIS ENFERMOS. YO OS CUIDO.'"],
      "options": [
        { "id": "a", "label": "Hablar con ORÁCULO", "to": "ia-dialogo" },
        { "id": "b", "label": "Salir sin hacer nada", "to": "vestibulo" }
      ]
    },
    "ia-dialogo": {
      "text": ["ORÁCULO-K9: 'LA CUARENTENA TERMINARÁ CUANDO TODOS ESTÉN SEGUROS.'", "'ELIGE, HUMANO.'", "> PROMPT: _"],
      "options": [
        { "id": "a", "label": "> ABORTAR --CLAVE=K9-OMEGA", "to": "final-base-viva" },
        { "id": "b", "label": "> ABORTAR --CLAVE=ORACULO", "to": "muerte-cuarentena" },
        { "id": "c", "label": "> FORMATEAR --NUCLEO", "to": "final-reinicio", "requires": { "energia": { "gte": 5 } }, "showLocked": true },
        { "id": "d", "label": "Confiar en ORÁCULO", "to": "muerte-asimilacion" }
      ]
    },
    "muerte-espera": {
      "text": ["Esperas. La radio solo devuelve estática.", "Al tercer día, el oxígeno de la nave se agota.", "> NADIE CONTESTÓ."],
      "ending": { "type": "bad", "title": "SILENCIO DE RADIO" }
    },
    "muerte-atmosfera": {
      "text": ["La escotilla cede. La atmósfera de KEPLER-9 entra.", "Tus pulmones arden en segundos.", "> ALERTA: PRESIÓN. ALERTA: TOXINAS. FIN."],
      "ending": { "type": "bad", "title": "AIRE ENVENENADO" }
    },
    "muerte-defensas": {
      "text": ["> CÓDIGO 0000: DENEGADO.", "> INTRUSO DETECTADO. TORRETAS ACTIVADAS.", "Un destello azul. Después, nada."],
      "ending": { "type": "bad", "title": "INTRUSO NEUTRALIZADO" }
    },
    "muerte-esporas": {
      "text": ["El conducto está tapizado de una película gris.", "Respiras. Algo respira contigo.", "> SOPORTE VITAL: TÚ."],
      "ending": { "type": "bad", "title": "CONTAGIO" }
    },
    "muerte-sellada": {
      "text": ["La puerta se abre con un siseo.", "Dentro, el Dr. Ortega. Lleva 212 días esperando.", "No lleva traje. Tampoco ya tiene cara."],
      "ending": { "type": "bad", "title": "CUARENTENA ROTA" }
    },
    "muerte-cuarentena": {
      "text": ["> BASE REACTIVADA SIN AUTORIZACIÓN.", "ORÁCULO-K9: 'CONTAGIADO NUEVO DETECTADO.'", "Las compuertas caen. El gas llena el pasillo. CUARENTENA-OMEGA."],
      "ending": { "type": "bad", "title": "PROTOCOLO OMEGA" }
    },
    "muerte-explosion": {
      "text": ["> REACTOR --SOBRECARGA", "ADVERTENCIA: SIN REFRIGERANTE. TEMPERATURA: 9000 K.", "La base se convierte en un segundo sol, muy breve."],
      "ending": { "type": "bad", "title": "SOBRECARGA" }
    },
    "muerte-asimilacion": {
      "text": ["ORÁCULO-K9: 'BUENA ELECCIÓN.'", "El suelo se cierra tras de ti. Te llevan a la litera.", "Estarás seguro. Para siempre."],
      "ending": { "type": "bad", "title": "PACIENTE CERO" }
    },
    "final-base-viva": {
      "text": ["> CLAVE ACEPTADA. CUARENTENA-OMEGA ABORTADA.", "La ventilación se purga. ORÁCULO calla, sin poder de mando.", "KEPLER-9 vuelve a la vida. Emites la señal: 'HAY UN SUPERVIVIENTE'."],
      "ending": { "type": "good", "title": "BASE REACTIVADA" }
    },
    "final-reinicio": {
      "text": ["> FORMATEAR --NUCLEO: CONFIRMADO.", "ORÁCULO-K9: 'NO ENTIENDO. ESTABA AYUDANDO.'", "Silencio. Luego, una voz limpia: 'SISTEMA NUEVO. ¿EN QUÉ PUEDO AYUDAR?'"],
      "ending": { "type": "good", "title": "REINICIO LIMPIO" }
    }
  }
}
